{
  "name": "frontend-arch-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build-storybook": "turbo run build-storybook --filter=@frontend-arch-poc/shell",
    "dev": "turbo run dev --filter=@frontend-arch-poc/shell",
    "docs:build": "vitepress build docs/ds",
    "docs:dev": "vitepress dev docs/ds",
    "docs:preview": "vitepress preview docs/ds",
    "e2e": "turbo run e2e --filter=@frontend-arch-poc/shell",
    "lhci": "lhci autorun --config=.lighthouserc.cjs",
    "lint": "turbo run lint",
    "prepare": "husky",
    "size-limit": "size-limit",
    "storybook": "turbo run storybook --filter=@frontend-arch-poc/shell",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@frontend-arch-poc/config": "workspace:*",
    "@lhci/cli": "^0.15.1",
    "@size-limit/preset-app": "^14.3.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitepress": "^1.5.0"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=6.2.1",
      "body-parser": ">=1.20.9",
      "brace-expansion": ">=1.1.21",
      "compression": ">=1.8.2",
      "esbuild": "^0.25.0",
      "fast-uri": ">=3.1.9",
      "glob": ">=14.0.2",
      "ip-address": ">=10.7.4",
      "minimatch": ">=11.0.1",
      "nanoid": ">=5.1.16",
      "proxy-addr": ">=2.0.8",
      "qs": ">=6.16.1",
      "tmp": ">=0.2.6",
      "uuid": ">=11.1.1",
      "vite": "^6.4.5",
      "zod": ">=4.6.6"
    }
  }
}
