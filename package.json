{
  "name": "frontend-arch-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build-storybook": "turbo run build-storybook --filter=@frontend-arch-poc/shell",
    "dev": "turbo run dev --filter=@frontend-arch-poc/shell",
    "e2e": "turbo run e2e --filter=@frontend-arch-poc/shell",
    "lhci": "lhci autorun --config=.lighthouserc.cjs",
    "lint": "turbo run lint",
    "prepare": "husky",
    "size-limit": "size-limit",
    "storybook": "turbo run storybook --filter=@frontend-arch-poc/shell",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@frontend-arch-poc/config": "workspace:*",
    "@lhci/cli": "^0.14.0",
    "@size-limit/preset-app": "^11.1.6",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "size-limit": "^11.1.6",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
