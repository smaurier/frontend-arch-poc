# Toggle OIDC authentication. Default: off.
VITE_AUTH_ENABLED=false

# When enabled, the shell expects a Keycloak instance at:
VITE_OIDC_AUTHORITY=http://localhost:8085/realms/frontend-arch-poc
VITE_OIDC_CLIENT_ID=shell-client

# Sentry DSN. Leave empty to disable observability.
VITE_SENTRY_DSN=
# Optional release tag (falls back to "dev").
VITE_APP_VERSION=

# Enable real-time SSE source instead of polling mock. Default: false.
VITE_SSE_ENABLED=false
VITE_SSE_URL=/api/events
VITE_SNAPSHOT_URL=/api/snapshot
